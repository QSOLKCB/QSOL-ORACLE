{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schema/research-response.schema.json",
  "title": "QSOL-ORACLE Structured Unknown Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "state",
    "subject",
    "question",
    "answer",
    "reason",
    "missing_evidence",
    "primary_source_targets",
    "suggested_searches",
    "suggested_searches_are_evidence",
    "plausible_completion_used",
    "plausible_completion_allowed",
    "truth_claim",
    "envelope_sha256"
  ],
  "properties": {
    "protocol": {"const": "QSOL-ORACLE-RESEARCH/1"},
    "state": {"const": "unknown"},
    "subject": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "null"},
    "reason": {"const": "insufficient-evidence"},
    "missing_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "primary_source_targets": {"type": "array", "items": {"type": "object"}},
    "suggested_searches": {"type": "array", "items": {"type": "object"}},
    "suggested_searches_are_evidence": {"const": false},
    "plausible_completion_used": {"const": false},
    "plausible_completion_allowed": {"const": false},
    "truth_claim": {"const": false},
    "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
